# docker-compose.prod.yml (staging and production). Copy to .env on the host and fill every value.
# Passwords go into URLs: use URL-safe characters (e.g. `openssl rand -hex 24`).

# Public site. A domain gets a Let's Encrypt certificate automatically; `localhost` uses Caddy's
# internal CA (local validation only).
SITE_ADDRESS=staging.example.com
APP_URL=https://staging.example.com
# Host ports Caddy listens on (80/443 on a server).
HTTP_PORT=80
HTTPS_PORT=443

# Database. The owner runs only the migrations; the server connects as bens_app (ADR-004).
POSTGRES_USER=bens
POSTGRES_PASSWORD=
POSTGRES_DB=bens
APP_DB_PASSWORD=

# At least 32 characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Storage (Cloudflare R2).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=bens-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# E-mail over SMTP (Resend).
SMTP_URL=smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465
EMAIL_FROM="Bens Seguros <nao-responda@example.com>"

LOG_LEVEL=info
