# Server (apps/server)
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# PostgreSQL (docker-compose.yml). Tests use one schema per Vitest worker in this same database.
# The app connects as `bens_app`, which row level security always applies to (ADR-004); only the
# Prisma CLI (migrations) uses the owner.
DATABASE_URL=postgresql://bens_app:bens_app@localhost:5432/bens
MIGRATION_DATABASE_URL=postgresql://bens:bens@localhost:5432/bens

# S3-compatible storage: MinIO in dev, R2 in production
# (S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bens-dev
S3_ACCESS_KEY_ID=bens
S3_SECRET_ACCESS_KEY=bens-minio
S3_FORCE_PATH_STYLE=true

# E-mail over SMTP: Mailpit in dev (inbox at http://localhost:8025), Resend in production
# (SMTP_URL=smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Bens Seguros <nao-responda@bensseguros.local>"
