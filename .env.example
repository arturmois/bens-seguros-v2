# Server (apps/server)
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# PostgreSQL (docker-compose.yml). Tests use one schema per Vitest worker in this same database.
# The app connects as `bens_app`, which row level security always applies to (ADR-004); only the
# Prisma CLI (migrations) uses the owner.
DATABASE_URL=postgresql://bens_app:bens_app@localhost:5432/bens
MIGRATION_DATABASE_URL=postgresql://bens:bens@localhost:5432/bens

# Public origin of the app. In dev it is Vite (the proxy keeps /api on the same origin); in production
# the Caddy site. E-mail links, the Origin check and the Secure cookie derive from it.
APP_URL=http://localhost:3000
# Signs sessions and encrypts TOTP secrets. At least 32 characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars
# true only behind a proxy that overwrites X-Forwarded-For (Caddy) with the server port closed.
TRUST_PROXY=false

# E-mail over SMTP: Mailpit in dev (inbox at http://localhost:8025), Resend in production
# (SMTP_URL=smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Bens Seguros <nao-responda@bensseguros.local>"

# Public sign-up. `closed` blocks only the public form; login and invites keep working.
# In production with `self_serve`, both Turnstile keys are required or the server refuses to boot.
SIGNUP_MODE=self_serve
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
