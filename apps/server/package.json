{
  "name": "@bens/server",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "email:dev": "email dev --dir src/emails --port 3002"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.5",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.0.10",
    "pg-boss": "12.33.3",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.9.5",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.5",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
