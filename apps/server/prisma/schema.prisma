generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Tenant root. Owned by the organizations module (Phase 4), which adds slug, logo, members and settings.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examples Example[]
}

// Disposable (Phase 2): exercises the tenant guard, the composite FK and P2002 → 409 until real
// tenant-scoped models exist. See docs/roadmap.md ("Remover o módulo exemplo").
model Example {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  parentId       String?  @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite FK: the database rejects a parent from another tenant.
  parent       Example?     @relation("ExampleTree", fields: [parentId, organizationId], references: [id, organizationId])
  children     Example[]    @relation("ExampleTree")

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}
