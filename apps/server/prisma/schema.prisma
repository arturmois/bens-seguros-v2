generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Tenant root. Owned by the organizations module (Phase 4), which adds slug, logo, members and settings.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examples Example[]
  sessions Session[]
}

// Disposable (Phase 2): exercises row level security, the composite FK and P2002 → 409 until real
// tenant-scoped models exist. See docs/roadmap.md ("Remover o módulo exemplo").
// Tenant-scoped (ADR-004): `organizationId` defaults to the transaction's tenant, and the migration
// that creates the table enables and forces RLS with the `tenant_isolation` policy.
model Example {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  name           String
  parentId       String?  @db.Uuid
  createdAt      DateTime @default(now())

  // RESTRICT: a cascade runs as the table owner and would skip row security (ADR-004).
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Composite FK: the database rejects a parent from another tenant.
  parent       Example?     @relation("ExampleTree", fields: [parentId, organizationId], references: [id, organizationId])
  children     Example[]    @relation("ExampleTree")

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

// Identity (Better Auth, ADR-003). User-level tables: no `organizationId`, so no row level security
// (ADR-004). Better Auth reads and writes them through the application client; ids are UUID v7
// generated by Prisma (`advanced.database.generateId: false`).
model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  twoFactorEnabled Boolean  @default(false)
  // Only an effective super-admin (this flag and 2FA on) gets `isSuperAdmin` in the context.
  isSuperAdmin     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  twoFactors      TwoFactor[]
  termsAcceptances TermsAcceptance[]
}

model Session {
  id                   String   @id @default(uuid(7)) @db.Uuid
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String   @db.Uuid
  // Written by the organizations module (Phase 4) after checking the membership.
  activeOrganizationId String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Password hash of the e-mail/password credential.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  // Encrypted by Better Auth with BETTER_AUTH_SECRET.
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

// Versioned consent (LGPD). User-level: no `organizationId`, so no row level security.
enum LegalDocument {
  TERMS
  PRIVACY
}

model TermsAcceptance {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @db.Uuid
  document   LegalDocument
  version    String
  acceptedAt DateTime      @default(now())
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, document, version])
}

// Better Auth rate limit (`storage: "database"`): survives a restart.
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}
