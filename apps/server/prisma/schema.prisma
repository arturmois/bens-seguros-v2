generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Tenant root. No `organizationId` of its own: visibility is the `tenant_isolation` policy in
// AD-006 (the id matches the transaction tenant, or the caller has a Member row).
model Organization {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String    @unique
  // ADR-014: the capability in the public Web Chat link (`/c/<publicChatKey>`), 32 hex characters.
  publicChatKey String    @unique
  // Branding for the Web Chat. The logo is read only by `GET /api/v1/organization/logo`.
  brandColor    String?
  greeting      String?
  logo          Bytes?
  logoMimeType  String?
  logoUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members       Member[]
  invitations   Invitation[]
  channels      Channel[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  sessions      Session[]
  lastActiveBy  User[]         @relation("UserLastActiveOrganization")
}

enum Role {
  ADMIN
  MANAGER
  COMMERCIAL
}

// Tenant-scoped (ADR-004, AD-006). `organizationId` defaults to the transaction tenant.
// At least one active ADMIN per organization is enforced by `updateMember` (ADR-016).
model Member {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  userId         String   @db.Uuid
  role           Role
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  ownedContacts         Contact[]
  assignedConversations Conversation[]

  @@unique([id, organizationId])
  @@unique([organizationId, userId])
}

// Catalog, no tenant. The onboarding seed is the single `trial` row.
model Plan {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  maxUsers  Int
  createdAt DateTime @default(now())

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Tenant-scoped (ADR-004, AD-007). The raw token is never stored. A pending invite is unique per
// e-mail inside the organization (partial index in the migration).
model Invitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  email          String
  role           Role
  tokenHash      String
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, tokenHash])
}

// Who acted: a user, the AI or the system itself (ADR-013). `actorUserId` is set only for USER
// (`AuditLog_actor_check` in the migration).
enum AuditActorType {
  USER
  AI
  SYSTEM
}

// Tenant-scoped (ADR-004, AD-013). `changes` never stores the denylisted personal keys;
// `audit.record` rewrites those values to "[alterado]" before insert.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  actorType      AuditActorType
  actorUserId    String?        @db.Uuid
  action         String
  entityId       String         @db.Uuid
  changes        Json
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizationId])
}

model Subscription {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @unique @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus
  trialEndsAt    DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizationId])
}

// Identity (Better Auth, ADR-003). User-level tables: no `organizationId`, so no row level security
// (ADR-004). Better Auth reads and writes them through the application client; ids are UUID v7
// generated by Prisma (`advanced.database.generateId: false`).
model User {
  id                       String   @id @default(uuid(7)) @db.Uuid
  name                     String
  email                    String   @unique
  emailVerified            Boolean  @default(false)
  image                    String?
  twoFactorEnabled         Boolean  @default(false)
  // Only an effective super-admin (this flag and 2FA on) gets `isSuperAdmin` in the context.
  isSuperAdmin             Boolean  @default(false)
  // The organization a new session starts in, while the membership stays active (org-web door 4).
  lastActiveOrganizationId String?  @db.Uuid
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  lastActiveOrganization Organization? @relation("UserLastActiveOrganization", fields: [lastActiveOrganizationId], references: [id], onDelete: SetNull)

  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  termsAcceptances TermsAcceptance[]
  memberships      Member[]
  auditLogs        AuditLog[]
  messages         Message[]
}

model Session {
  id                   String   @id @default(uuid(7)) @db.Uuid
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String   @db.Uuid
  // Written by the organizations module (Phase 4) after checking the membership.
  activeOrganizationId String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Password hash of the e-mail/password credential.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  // Encrypted by Better Auth with BETTER_AUTH_SECRET.
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

// Versioned consent (LGPD). User-level: no `organizationId`, so no row level security.
enum LegalDocument {
  TERMS
  PRIVACY
}

model TermsAcceptance {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @db.Uuid
  document   LegalDocument
  version    String
  acceptedAt DateTime      @default(now())
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, document, version])
}

// Better Auth rate limit (`storage: "database"`): survives a restart.
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Where a conversation comes in (ADR-013). F2 has only the Web Chat, one per organization
// (`Channel_one_web_chat`, partial index in the migration); WHATSAPP arrives with F9.
enum ChannelKind {
  WEB_CHAT
}

// Tenant-scoped (ADR-004). Owned by `modules/channels`.
model Channel {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  kind           ChannelKind
  name           String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversations Conversation[]

  @@unique([id, organizationId])
}

// The broker's customer, identified by the E.164 phone, unique per organization (handoff §9).
// `ownerId` is the user id of a member of the same organization; null means the lead is in the queue
// (ADR-016). Tenant-scoped (ADR-004). Owned by `modules/contacts`.
model Contact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  phoneE164      String
  ownerId        String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner         Member?        @relation(fields: [organizationId, ownerId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  conversations Conversation[]

  @@unique([id, organizationId])
  @@unique([organizationId, phoneE164])
}

// ADR-013: WAITING = waiting for the customer (the last message was ours).
enum ConversationStatus {
  OPEN
  WAITING
  CLOSED
}

enum ConversationHandler {
  AI
  QUEUE
  HUMAN
}

// ADR-013: state (`status`) and who conducts it (`handler`, `assigneeId` when HUMAN) are
// independent. At most one conversation per contact and channel is not CLOSED
// (`Conversation_one_open`); the checks tie `assigneeId` to HUMAN and `closedAt` to CLOSED.
// Tenant-scoped (ADR-004). Owned by `modules/conversations`.
model Conversation {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  contactId      String              @db.Uuid
  channelId      String              @db.Uuid
  status         ConversationStatus
  handler        ConversationHandler
  assigneeId     String?             @db.Uuid
  lastSeq        Int                 @default(0)
  lastMessageAt  DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contact      Contact      @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  channel      Channel      @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  assignee     Member?      @relation(fields: [organizationId, assigneeId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  messages     Message[]

  @@unique([id, organizationId])
  // Target of the message foreign key: a message's channel is its conversation's channel.
  @@unique([id, channelId, organizationId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthor {
  CONTACT
  AI
  HUMAN
  SYSTEM
}

// UNSUPPORTED is a non-text message, stored without content (handoff §16).
enum MessageKind {
  TEXT
  UNSUPPORTED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

// ADR-013: `seq` orders a conversation (unique per conversation); `externalId` dedupes the inbound
// of a channel (`Message_channel_externalId`, partial index in the migration). The checks tie
// direction, author, delivery status and text together. Tenant-scoped (ADR-004). Owned by
// `modules/conversations`.
model Message {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @default(dbgenerated("(current_setting('app.tenant_id'::text))::uuid")) @db.Uuid
  conversationId String           @db.Uuid
  channelId      String           @db.Uuid
  seq            Int
  direction      MessageDirection
  author         MessageAuthor
  authorUserId   String?          @db.Uuid
  kind           MessageKind
  text           String?
  deliveryStatus DeliveryStatus?
  externalId     String?
  failureReason  String?
  sentAt         DateTime
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation Conversation @relation(fields: [conversationId, channelId, organizationId], references: [id, channelId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  authorUser   User?        @relation(fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, conversationId, seq])
}
